{
  "name": "@code-moniker/city-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automatic software communities from Code Moniker indexes, with a Three.js scene adapter.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "analyze": "node dist/cli.js",
    "dev": "vite --host 127.0.0.1 --port 5183",
    "build:preview": "vite build"
  },
  "dependencies": {
    "@code-moniker/client": "file:../client",
    "three": "^0.180.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/d3-force": "^3.0.10"
  }
}
